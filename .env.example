# digest-builder environment variables
#
# Copy this to .env and fill in real values.
# docker-compose.yml reads these automatically.

TZ=Europe/London

# ── Wallabag credentials ────────────────────────────────────────────
WALLABAG_URL=https://wallabag.example.net
WALLABAG_CLIENT_ID=your_client_id
WALLABAG_CLIENT_SECRET=your_client_secret
WALLABAG_USERNAME=your_username
WALLABAG_PASSWORD=your_password

# ── Output and state paths (defaults work for Docker) ───────────────
# OUTPUT_DIR=./output
# STATE_DIR=./state
